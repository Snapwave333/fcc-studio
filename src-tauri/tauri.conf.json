{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serenity",
  "version": "0.1.0",
  "identifier": "com.serenity.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Serenity",
        "width": 1480,
        "height": 920,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Autonomous vibe-coding studio for Free Claude Code"
  }
}