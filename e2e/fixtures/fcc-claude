#!/usr/bin/env node
const args = process.argv.slice(2);
if (args.includes("--version")) {
  process.stdout.write("fcc-claude e2e-fixture 1.0.0\n");
  process.exit(0);
}
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (d) => (input += d));
process.stdin.on("end", () => {
  const resumeIdx = args.indexOf("--resume");
  const session = resumeIdx >= 0 ? args[resumeIdx + 1] : "e2e-session-1";
  const emit = (o) => process.stdout.write(JSON.stringify(o) + "\n");
  const mode = args.includes("--dangerously-skip-permissions") ? "yolo" : args[args.indexOf("--permission-mode") + 1];
  const prompt = input.trim();
  emit({ type: "system", subtype: "init", session_id: session, model: "e2e-model" });
  emit({ type: "stream_event", event: { type: "message_start" } });
  const intro = `Received ${prompt.length} chars in ${mode} mode.`;
  for (const part of intro.match(/.{1,8}/g)) {
    emit({ type: "stream_event", event: { type: "content_block_delta", delta: { type: "text_delta", text: part } } });
  }
  emit({ type: "assistant", message: { content: [{ type: "text", text: intro }, { type: "tool_use", id: "tool-1", name: "Bash", input: { command: "echo listing" } }] } });
  emit({ type: "user", message: { content: [{ type: "tool_result", tool_use_id: "tool-1", content: "listing" }] } });
  const echo = "Echo: **" + prompt.split("\n")[0] + "**";
  emit({ type: "stream_event", event: { type: "message_start" } });
  emit({ type: "stream_event", event: { type: "content_block_delta", delta: { type: "text_delta", text: echo } } });
  emit({ type: "assistant", message: { content: [{ type: "text", text: echo }] } });
  emit({ type: "result", subtype: "success", session_id: session, num_turns: 2, duration_ms: 1234, total_cost_usd: 0, usage: { input_tokens: 10, output_tokens: 5 } });
});
